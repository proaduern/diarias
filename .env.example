# Uso local com Postgres próprio: pode repetir a mesma URL nas duas variáveis.
# Uso com Neon: DATABASE_URL é a connection string "pooled" (com "-pooler" no
# host, painel Neon > Connect, toggle "Pooled connection" ligado) e DIRECT_URL
# é a connection string direta (mesmo painel, toggle desligado) — usada só
# para rodar as migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/diarias?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/diarias?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
