generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Perfis e organização
// ---------------------------------------------------------------------------

enum PerfilUsuario {
  ADMIN
  DEMANDANTE
}

model Unidade {
  id        String   @id @default(cuid())
  nome      String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios      Usuario[]
  beneficiarios Beneficiario[]
  pedidos       PedidoDiaria[]
  orcamentos    OrcamentoUnidade[]
}

model Usuario {
  id           String        @id @default(cuid())
  nome         String
  email        String        @unique
  cpf          String        @unique
  senhaHash    String
  perfil       PerfilUsuario @default(DEMANDANTE)
  unidadeId    String?
  unidade      Unidade?      @relation(fields: [unidadeId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Permissões que o admin pode delegar a um demandante, sempre restritas à
  // própria unidade de vínculo dele (nunca a outras unidades).
  podeImportarUsuarios    Boolean @default(false)
  podeEditarBeneficiarios Boolean @default(false)

  pedidosCriados PedidoDiaria[] @relation("PedidoCriadoPor")
  aprovacoes     Aprovacao[]    @relation("AprovacoesFeitas")
}

// ---------------------------------------------------------------------------
// Beneficiários e parametrização (categorias, destinos, valores)
// ---------------------------------------------------------------------------

model CategoriaBeneficiario {
  id               String   @id @default(cuid())
  nome             String   @unique
  descricao        String?
  limiteAnualDias  Int      @default(60)
  ordem            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  beneficiarios Beneficiario[]
  valores       ValorDiaria[]
}

model TipoDestino {
  id        String   @id @default(cuid())
  nome      String   @unique
  descricao String?
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  valores ValorDiaria[]
  pedidos PedidoDiaria[]
}

model ValorDiaria {
  id            String   @id @default(cuid())
  categoriaId   String
  categoria     CategoriaBeneficiario @relation(fields: [categoriaId], references: [id])
  tipoDestinoId String
  tipoDestino   TipoDestino @relation(fields: [tipoDestinoId], references: [id])
  moeda         String   @default("BRL")
  valorCentavos Int
  vigenteDesde  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([categoriaId, tipoDestinoId])
}

model Beneficiario {
  id                String   @id @default(cuid())
  nome              String
  nomeNormalizado   String
  cpf               String   @unique
  banco             String
  agencia           String
  contaCorrente     String
  categoriaId       String
  categoria         CategoriaBeneficiario @relation(fields: [categoriaId], references: [id])
  unidadeVinculoId  String?
  unidadeVinculo    Unidade? @relation(fields: [unidadeVinculoId], references: [id])
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pedidos PedidoDiaria[]
}

// ---------------------------------------------------------------------------
// Programação de atividades (Fase 1 da expansão multi-benefício)
// ---------------------------------------------------------------------------

enum CategoriaAtividade {
  ACADEMICA
  ADMINISTRATIVA
}

// Taxonomia de enquadramento de atividade, totalmente editável pelo admin
// (a regulamentação muda com frequência — nunca hardcode nomes/subtipos no
// código, sempre resolva por EnquadramentoAtividade.id).
model EnquadramentoAtividade {
  id                String             @id @default(cuid())
  categoria         CategoriaAtividade
  nome              String
  descricao         String?
  // Se marcado, o formulário exige um campo de detalhamento em texto livre
  // (ex.: nome do projeto institucional, disciplina, "especifique").
  exigeDetalhamento Boolean            @default(false)
  // Se marcado, o formulário exige um anexo (ex.: plano de aula, comprovante).
  exigeAnexo        Boolean            @default(false)
  ativo             Boolean            @default(true)
  ordem             Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  atividades Atividade[]

  @@unique([categoria, nome])
}

model Atividade {
  id              String   @id @default(cuid())
  pedidoId        String
  pedido          PedidoDiaria @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  enquadramentoId String
  enquadramento   EnquadramentoAtividade @relation(fields: [enquadramentoId], references: [id])
  descricao       String
  detalhamento    String?
  dataHoraInicio  DateTime
  dataHoraFim     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  anexos Anexo[]

  @@index([pedidoId])
}

// ---------------------------------------------------------------------------
// Pedido de diária
// ---------------------------------------------------------------------------

// Status de aprovação do pedido. A situação da prestação de contas
// pós-viagem (aguardando relatório / atrasado / devolução pendente /
// concluído) é derivada dinamicamente a partir de chegadaSede e
// relatorioEnviadoEm (ver lib/prestacao-contas.ts) e não é armazenada aqui.
enum StatusPedido {
  AGUARDANDO_JUSTIFICATIVA_PRAZO
  AGUARDANDO_JUSTIFICATIVA_ATIVIDADE
  AGUARDANDO_DELIBERACAO_LIMITE
  AGUARDANDO_DEFERIMENTO
  DEFERIDO
  INDEFERIDO
}

enum TipoAnexo {
  AUTORIZACAO_LIMITE
  RELATORIO_VIAGEM
  PLANO_AULA
  COMPROVANTE_ATIVIDADE
}

model PedidoDiaria {
  id            String   @id @default(cuid())

  beneficiarioId String
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id])

  unidadeSolicitanteId String
  unidadeSolicitante   Unidade @relation(fields: [unidadeSolicitanteId], references: [id])

  tipoDestinoId String
  tipoDestino   TipoDestino @relation(fields: [tipoDestinoId], references: [id])

  municipioDestino String
  finalidade       String
  kmDeclarado      Int

  saidaSede       DateTime
  chegadaDestino  DateTime
  saidaDestino    DateTime
  chegadaSede     DateTime

  // Resultado do motor de cálculo (snapshot no momento do deferimento)
  noites               Int?
  ultimaNoiteQualifica Boolean?
  diarias              Decimal? @db.Decimal(6, 2)
  valorUnitarioCentavos Int?
  valorTotalCentavos    Int?

  status StatusPedido @default(AGUARDANDO_DEFERIMENTO)

  justificativaPrazoCurto String?
  justificativaPrazoAceitaPor String?

  // Exceção de horário de atividade (Fase 1): a viagem se estende além do
  // estritamente necessário para as atividades vinculadas (chegada antes do
  // início mínimo ou saída depois do fim máximo). Não bloqueia o pedido, mas
  // exige ciência do demandante (diária/hospedagem só cobre o período estrito
  // da atividade) e justificativa do gestor da unidade (sem prejuízo ao
  // serviço, compensação dos dias afastados conforme legislação).
  cienciaPrazoAtividade        Boolean @default(false)
  justificativaGestorAtividade String?
  justificativaGestorAceitaPor String?

  relatorioEnviadoEm       DateTime?
  pendenciaRegularizadaEm  DateTime?
  pendenciaRegularizadaPor String?

  criadoPorId String
  criadoPor   Usuario @relation("PedidoCriadoPor", fields: [criadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atividades  Atividade[]
  anexos      Anexo[]
  aprovacoes  Aprovacao[]

  @@index([beneficiarioId])
  @@index([unidadeSolicitanteId])
  @@index([status])
}

model Anexo {
  id           String    @id @default(cuid())
  pedidoId     String
  pedido       PedidoDiaria @relation(fields: [pedidoId], references: [id])
  // Presente apenas para anexos de atividade (plano de aula, comprovante de
  // treinamento). pedidoId continua preenchido nesse caso (denormalizado, a
  // partir de atividade.pedidoId) para reaproveitar a autorização por
  // unidade já existente em /api/anexos/[id].
  atividadeId  String?
  atividade    Atividade? @relation(fields: [atividadeId], references: [id])
  tipo         TipoAnexo
  nomeArquivo  String
  caminho      String? // legado (armazenamento em disco); não usado mais, ver `conteudo`
  conteudo     Bytes?
  enviadoEm    DateTime  @default(now())
}

model Aprovacao {
  id          String   @id @default(cuid())
  pedidoId    String
  pedido      PedidoDiaria @relation(fields: [pedidoId], references: [id])
  aprovadorId String
  aprovador   Usuario  @relation("AprovacoesFeitas", fields: [aprovadorId], references: [id])
  decisao     String
  motivo      String?
  createdAt   DateTime @default(now())
}

model OrcamentoUnidade {
  id                String   @id @default(cuid())
  unidadeId         String
  unidade           Unidade  @relation(fields: [unidadeId], references: [id])
  ano               Int
  valorTotalCentavos Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([unidadeId, ano])
}

model ConfiguracaoSistema {
  id                       Int     @id @default(1)
  limiteMensalDiarias      Int     @default(10)
  prazoMinimoDiasAntecedencia Int  @default(5)
  prazoRelatorioDiasUteis  Int     @default(5)
  prazoDevolucaoDiasCorridos Int   @default(30)
  kmMinimoSemPernoite      Int     @default(40)
  duracaoMinimaHoras       Int     @default(6)
}
