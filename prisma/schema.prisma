generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Perfis e organização
// ---------------------------------------------------------------------------

enum PerfilUsuario {
  ADMIN
  DEMANDANTE
}

model Unidade {
  id        String   @id @default(cuid())
  nome      String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios      Usuario[]
  beneficiarios Beneficiario[]
  viagens       Viagem[]
  orcamentos    OrcamentoUnidade[]
  cotasContrato CotaContratoUnidade[]
}

model Usuario {
  id        String        @id @default(cuid())
  nome      String
  email     String        @unique
  cpf       String        @unique
  senhaHash String
  perfil    PerfilUsuario @default(DEMANDANTE)
  unidadeId String?
  unidade   Unidade?      @relation(fields: [unidadeId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Permissões que o admin pode delegar a um demandante, sempre restritas à
  // própria unidade de vínculo dele (nunca a outras unidades).
  podeImportarUsuarios    Boolean @default(false)
  podeEditarBeneficiarios Boolean @default(false)

  viagensCriadas Viagem[]    @relation("ViagemCriadaPor")
  aprovacoes     Aprovacao[] @relation("AprovacoesFeitas")
}

// ---------------------------------------------------------------------------
// Beneficiários e parametrização (categorias, destinos, valores)
// ---------------------------------------------------------------------------

model CategoriaBeneficiario {
  id                 String   @id @default(cuid())
  nome               String   @unique
  descricao          String?
  limiteAnualDias    Int      @default(60)
  // Elegibilidade para hospedagem (Fase 3), editável pelo admin — hoje
  // restrita por normativo a categorias de colaborador externo, mas o
  // mapeamento fica em dado, não no código, pois pode ser ampliado por
  // novo normativo.
  elegivelHospedagem Boolean  @default(false)
  ordem              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  beneficiarios Beneficiario[]
  valores       ValorDiaria[]
}

model TipoDestino {
  id        String   @id @default(cuid())
  nome      String   @unique
  descricao String?
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  valores ValorDiaria[]
  pedidos PedidoDiaria[]
}

model ValorDiaria {
  id            String                @id @default(cuid())
  categoriaId   String
  categoria     CategoriaBeneficiario @relation(fields: [categoriaId], references: [id])
  tipoDestinoId String
  tipoDestino   TipoDestino           @relation(fields: [tipoDestinoId], references: [id])
  moeda         String                @default("BRL")
  valorCentavos Int
  vigenteDesde  DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([categoriaId, tipoDestinoId])
}

model Beneficiario {
  id               String                @id @default(cuid())
  nome             String
  nomeNormalizado  String
  cpf              String                @unique
  banco            String
  agencia          String
  contaCorrente    String
  categoriaId      String
  categoria        CategoriaBeneficiario @relation(fields: [categoriaId], references: [id])
  unidadeVinculoId String?
  unidadeVinculo   Unidade?              @relation(fields: [unidadeVinculoId], references: [id])
  // Exigidos na aplicação (não no schema) apenas quando unidadeVinculoId
  // não é nulo, isto é, quando o beneficiário tem vínculo funcional com uma
  // unidade. Um Agente Colaborador externo (unidadeVinculoId nulo) dispensa
  // matrícula e cargo/função — basta CPF — pois não possui nenhum dos dois.
  matricula        String?
  cargo            String?
  ativo            Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  viagens Viagem[]
}

// ---------------------------------------------------------------------------
// Viagem (Fase 3 da expansão multi-benefício)
//
// Entidade que reúne os dados compartilhados por todos os tipos de pedido
// (diária, hospedagem e, futuramente, passagem aérea/terrestre): quem
// viaja, sede/destino/aeroporto e a programação de atividades. O
// demandante preenche esses dados uma única vez e, a partir deles, marca
// um ou mais tipos de pedido — cada um vira um registro próprio (ex.:
// PedidoDiaria, PedidoHospedagem), com seu próprio cálculo/status/aprovação,
// mas todos amarrados à mesma Viagem e validados contra a mesma
// programação de atividades (lib/atividades.ts).
// ---------------------------------------------------------------------------

model Viagem {
  id String @id @default(cuid())

  beneficiarioId String
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id])

  unidadeSolicitanteId String
  unidadeSolicitante   Unidade @relation(fields: [unidadeSolicitanteId], references: [id])

  finalidade       String
  municipioDestino String
  kmDeclarado      Int

  sedeCidade    String
  sedeEstado    String
  destinoEstado String

  // Trecho aéreo opcional: quando o beneficiário for buscado no aeroporto, a
  // viagem tem 3 trechos — terrestre sede->aeroporto, aéreo
  // aeroporto->aeroporto, terrestre aeroporto->destino — cada um com sua
  // própria fórmula de tempo (ver lib/tempo-viagem.ts). kmDeclarado acima
  // continua sendo a distância terrestre direta sede-destino, usada no
  // Art. 17, I (pernoite) independentemente de haver trecho aéreo.
  vaiBuscarAeroporto         Boolean @default(false)
  kmSedeAeroporto            Int?
  kmVoo                      Int?
  kmAeroportoDestino         Int?
  tempoViagemEstimadoMinutos Int?

  saidaSede      DateTime
  chegadaDestino DateTime
  saidaDestino   DateTime
  chegadaSede    DateTime

  criadoPorId String
  criadoPor   Usuario @relation("ViagemCriadaPor", fields: [criadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atividades           Atividade[]
  pedidosDiaria        PedidoDiaria[]
  pedidosHospedagem    PedidoHospedagem[]
  pedidosPassagemAerea PedidoPassagemAerea[]

  @@index([beneficiarioId])
  @@index([unidadeSolicitanteId])
}

// ---------------------------------------------------------------------------
// Programação de atividades (Fase 1 da expansão multi-benefício)
// ---------------------------------------------------------------------------

enum CategoriaAtividade {
  ACADEMICA
  ADMINISTRATIVA
}

// Taxonomia de enquadramento de atividade, totalmente editável pelo admin
// (a regulamentação muda com frequência — nunca hardcode nomes/subtipos no
// código, sempre resolva por EnquadramentoAtividade.id).
model EnquadramentoAtividade {
  id                String             @id @default(cuid())
  categoria         CategoriaAtividade
  nome              String
  descricao         String?
  // Se marcado, o formulário exige um campo de detalhamento em texto livre
  // (ex.: nome do projeto institucional, disciplina, "especifique").
  exigeDetalhamento Boolean            @default(false)
  // Se marcado, o formulário exige um anexo (ex.: plano de aula, comprovante).
  exigeAnexo        Boolean            @default(false)
  ativo             Boolean            @default(true)
  ordem             Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  atividades Atividade[]

  @@unique([categoria, nome])
}

model Atividade {
  id              String                 @id @default(cuid())
  viagemId        String
  viagem          Viagem                 @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  enquadramentoId String
  enquadramento   EnquadramentoAtividade @relation(fields: [enquadramentoId], references: [id])
  descricao       String
  detalhamento    String?
  dataHoraInicio  DateTime
  dataHoraFim     DateTime
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  anexos Anexo[]

  @@index([viagemId])
}

// ---------------------------------------------------------------------------
// Pedido de diária
// ---------------------------------------------------------------------------

// Status de aprovação do pedido. A situação da prestação de contas
// pós-viagem (aguardando relatório / atrasado / devolução pendente /
// concluído) é derivada dinamicamente a partir de chegadaSede e
// relatorioEnviadoEm (ver lib/prestacao-contas.ts) e não é armazenada aqui.
enum StatusPedido {
  AGUARDANDO_JUSTIFICATIVA_PRAZO
  AGUARDANDO_JUSTIFICATIVA_ATIVIDADE
  AGUARDANDO_DELIBERACAO_LIMITE
  AGUARDANDO_DEFERIMENTO
  DEFERIDO
  INDEFERIDO
}

enum TipoAnexo {
  AUTORIZACAO_LIMITE
  RELATORIO_VIAGEM
  PLANO_AULA
  COMPROVANTE_ATIVIDADE
}

model PedidoDiaria {
  id String @id @default(cuid())

  viagemId String
  viagem   Viagem @relation(fields: [viagemId], references: [id])

  tipoDestinoId String
  tipoDestino   TipoDestino @relation(fields: [tipoDestinoId], references: [id])

  // Resultado do motor de cálculo (snapshot no momento do deferimento)
  noites                Int?
  ultimaNoiteQualifica  Boolean?
  diarias               Decimal? @db.Decimal(6, 2)
  valorUnitarioCentavos Int?
  valorTotalCentavos    Int?

  status StatusPedido @default(AGUARDANDO_DEFERIMENTO)

  justificativaPrazoCurto     String?
  justificativaPrazoAceitaPor String?

  // Exceção de horário de atividade (Fase 1): a viagem se estende além do
  // estritamente necessário para as atividades vinculadas (chegada antes do
  // início mínimo ou saída depois do fim máximo). Não bloqueia o pedido, mas
  // exige ciência do demandante (diária/hospedagem só cobre o período estrito
  // da atividade) e justificativa do gestor da unidade (sem prejuízo ao
  // serviço, compensação dos dias afastados conforme legislação).
  cienciaPrazoAtividade        Boolean @default(false)
  justificativaGestorAtividade String?
  justificativaGestorAceitaPor String?

  relatorioEnviadoEm       DateTime?
  pendenciaRegularizadaEm  DateTime?
  pendenciaRegularizadaPor String?

  // Emissão de portaria (.docx) para download pelo admin, feita após o
  // deferimento e levada à assinatura no SEI. numeroProcessoSei e
  // idPropostaConcessao vêm de outro processo/sistema (SEI e Proposta de
  // Concessão de Diárias) e são digitados manualmente — nunca inferidos a
  // partir do id interno deste pedido. portariaNumero/portariaData também
  // são sempre digitados manualmente (sem contador automático no sistema).
  // Persistidos aqui para serem reaproveitados numa reemissão.
  numeroProcessoSei   String?
  idPropostaConcessao String?
  portariaNumero      String?
  portariaData        DateTime?
  portariaEmitidaEm   DateTime?
  portariaEmitidaPor  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anexos     Anexo[]
  aprovacoes Aprovacao[]

  @@index([viagemId])
  @@index([status])
}

// Pedido de hospedagem — mutuamente exclusivo com PedidoDiaria na mesma
// Viagem (diária já cobre alimentação+hospedagem). Elegível apenas para
// beneficiários de categoria com `elegivelHospedagem = true` (ver
// CategoriaBeneficiario), mapeamento editável pelo admin pois a
// regulamentação pode mudar. Não há tabela oficial de valores de
// hospedagem no sistema — o valor vem de cotação feita fora do sistema e
// é digitado manualmente pelo responsável (valorTotalCentavos), exigido
// antes do deferimento.
model PedidoHospedagem {
  id String @id @default(cuid())

  viagemId String
  viagem   Viagem @relation(fields: [viagemId], references: [id])

  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id])

  status StatusPedido @default(AGUARDANDO_DEFERIMENTO)

  // Cotação feita fora do sistema (hotel, diária de hospedagem etc.) e
  // digitada manualmente pelo responsável — nunca calculada pelo sistema.
  valorTotalCentavos Int?
  valorCotadoPor     String?
  valorCotadoEm      DateTime?

  justificativaPrazoCurto     String?
  justificativaPrazoAceitaPor String?

  cienciaPrazoAtividade        Boolean @default(false)
  justificativaGestorAtividade String?
  justificativaGestorAceitaPor String?

  relatorioEnviadoEm       DateTime?
  pendenciaRegularizadaEm  DateTime?
  pendenciaRegularizadaPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anexos     Anexo[]
  aprovacoes Aprovacao[]

  @@index([viagemId])
  @@index([status])
}

// Pedido de passagem aérea — não é mutuamente exclusivo com diária/
// hospedagem (a consonância entre eles é garantida pela mesma programação
// de atividades/horário crítico, compartilhada via Viagem). O valor da
// passagem vem de cotação feita fora do sistema e é digitado manualmente
// pelo responsável (admin ou alguém por ele designado), nunca calculado.
model PedidoPassagemAerea {
  id String @id @default(cuid())

  viagemId String
  viagem   Viagem @relation(fields: [viagemId], references: [id])

  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id])

  status StatusPedido @default(AGUARDANDO_DEFERIMENTO)

  valorTotalCentavos Int?
  valorCotadoPor     String?
  valorCotadoEm      DateTime?

  justificativaPrazoCurto     String?
  justificativaPrazoAceitaPor String?

  cienciaPrazoAtividade        Boolean @default(false)
  justificativaGestorAtividade String?
  justificativaGestorAceitaPor String?

  relatorioEnviadoEm       DateTime?
  pendenciaRegularizadaEm  DateTime?
  pendenciaRegularizadaPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anexos     Anexo[]
  aprovacoes Aprovacao[]

  @@index([viagemId])
  @@index([status])
}

model Anexo {
  id String @id @default(cuid())

  // Um anexo pertence a exatamente um pedido (diária OU hospedagem) — usado
  // para AUTORIZACAO_LIMITE/RELATORIO_VIAGEM — OU a uma atividade da viagem
  // — usado para PLANO_AULA/COMPROVANTE_ATIVIDADE. Nunca os dois.
  pedidoDiariaId        String?
  pedidoDiaria          PedidoDiaria?        @relation(fields: [pedidoDiariaId], references: [id])
  pedidoHospedagemId    String?
  pedidoHospedagem      PedidoHospedagem?    @relation(fields: [pedidoHospedagemId], references: [id])
  pedidoPassagemAereaId String?
  pedidoPassagemAerea   PedidoPassagemAerea? @relation(fields: [pedidoPassagemAereaId], references: [id])
  atividadeId           String?
  atividade             Atividade?           @relation(fields: [atividadeId], references: [id])

  tipo        TipoAnexo
  nomeArquivo String
  caminho     String? // legado (armazenamento em disco); não usado mais, ver `conteudo`
  conteudo    Bytes?
  enviadoEm   DateTime  @default(now())
}

model Aprovacao {
  id                    String               @id @default(cuid())
  pedidoDiariaId        String?
  pedidoDiaria          PedidoDiaria?        @relation(fields: [pedidoDiariaId], references: [id])
  pedidoHospedagemId    String?
  pedidoHospedagem      PedidoHospedagem?    @relation(fields: [pedidoHospedagemId], references: [id])
  pedidoPassagemAereaId String?
  pedidoPassagemAerea   PedidoPassagemAerea? @relation(fields: [pedidoPassagemAereaId], references: [id])
  aprovadorId           String
  aprovador             Usuario              @relation("AprovacoesFeitas", fields: [aprovadorId], references: [id])
  decisao               String
  motivo                String?
  createdAt             DateTime             @default(now())
}

// ---------------------------------------------------------------------------
// Contratos e controle de saldo (hospedagem, passagem aérea, passagem
// terrestre — este último ainda sem tipo de pedido próprio, mas o
// cadastro do contrato já fica disponível para quando o contrato existir).
// ---------------------------------------------------------------------------

enum TipoBeneficioContrato {
  HOSPEDAGEM
  PASSAGEM_AEREA
  PASSAGEM_TERRESTRE
}

// Pré-cadastro de contrato, feito pelo admin (ou alguém por ele designado).
// Todos os campos são editáveis pois contratos recebem aditivos de valor/
// duração, ou trocam de empresa por completo em rescisão/não-renovação.
model Contrato {
  id String @id @default(cuid())

  tipoBeneficio TipoBeneficioContrato

  empresaNome       String
  empresaCnpj       String
  numeroContrato    String
  numeroProcessoSei String

  vigenciaInicio DateTime
  vigenciaFim    DateTime

  // Saldo global do contrato (Art. da cota/saldo) — a soma dos pedidos
  // vinculados a este contrato nunca pode ultrapassar este valor (ver
  // lib/saldo-contrato.ts).
  valorTotalCentavos Int

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cotasPorUnidade      CotaContratoUnidade[]
  pedidosHospedagem    PedidoHospedagem[]
  pedidosPassagemAerea PedidoPassagemAerea[]

  @@index([tipoBeneficio])
}

// Cota de uma unidade dentro de um contrato. cotaCentavos = 0 significa que
// a unidade não tem teto próprio e usa o saldo global do contrato (editável
// pelo admin).
model CotaContratoUnidade {
  id String @id @default(cuid())

  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  unidadeId  String
  unidade    Unidade  @relation(fields: [unidadeId], references: [id])

  cotaCentavos Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contratoId, unidadeId])
}

model OrcamentoUnidade {
  id                 String   @id @default(cuid())
  unidadeId          String
  unidade            Unidade  @relation(fields: [unidadeId], references: [id])
  ano                Int
  valorTotalCentavos Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([unidadeId, ano])
}

model ConfiguracaoSistema {
  id                          Int @id @default(1)
  limiteMensalDiarias         Int @default(10)
  prazoMinimoDiasAntecedencia Int @default(5)
  prazoRelatorioDiasUteis     Int @default(5)
  prazoDevolucaoDiasCorridos  Int @default(30)
  kmMinimoSemPernoite         Int @default(40)
  duracaoMinimaHoras          Int @default(6)

  // Dados fixos usados na emissão de portaria (.docx) de concessão de
  // diárias, editados apenas quando há nova delegação de poderes ou troca
  // de gestão — reaproveitados em toda emissão.
  numeroPortariaDelegacao String?
  dataPortariaDelegacao   DateTime?
  assinante1Nome          String?
  assinante1Cargo         String?
  assinante2Nome          String?
  assinante2Cargo         String?
}
